  "repository": {
    "type": "git",
    "url": "git+https://github.com/dragoonant/magitek-wars.git"
  },
  "author": "evilgouki",
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
